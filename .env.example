# FeedForge configuration for Docker Compose.
#
#   cp .env.example .env
#   docker compose up -d
#
# Every value below is optional — `docker compose up -d` with no .env at all
# starts a working instance on http://localhost:8080. Uncomment what you need.

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------

# Required to create/edit/delete feeds and to run pattern previews. Leave it
# empty and anyone who can reach the port can create feeds and make your
# server fetch arbitrary URLs on their behalf. Generated feed URLs stay
# public either way, so readers never need the token.
#   openssl rand -hex 24
#FEEDFORGE_TOKEN=

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# Host interface the port is published on. The default reaches the whole
# internet: Docker inserts its own iptables rules ahead of ufw/firewalld, so
# a published port is open even when the firewall lists no rule for it.
# Set 127.0.0.1 whenever a reverse proxy (or an SSH tunnel) fronts FeedForge.
#FEEDFORGE_BIND=127.0.0.1

# Host port. The container always listens on 8080 internally.
#FEEDFORGE_PORT=8080

# Public origin baked into generated feed URLs (<atom:link rel="self">,
# JSON Feed feed_url). Without it FeedForge trusts the request's Host header,
# which means whoever asks first decides what your subscribers see.
# With docker-compose.caddy.yml you can leave this empty — the overlay
# defaults it to https://$FEEDFORGE_DOMAIN. Set it explicitly only if you
# changed CADDY_HTTPS_PORT, and include the port.
#FEEDFORGE_BASE_URL=https://feeds.example.com

# ---------------------------------------------------------------------------
# Fetching
# ---------------------------------------------------------------------------

# Allow scraping private/LAN/loopback addresses. This disables the SSRF
# guard that keeps a feed from pointing at your router's admin page or a
# cloud metadata endpoint, and it re-enables HTTP_PROXY/HTTPS_PROXY. Turn it
# on only on a trusted LAN where you control everyone who can create feeds.
#FEEDFORGE_ALLOW_PRIVATE=false

# Max size of a fetched source page, in MB.
#FEEDFORGE_MAX_FETCH_MB=5

# ---------------------------------------------------------------------------
# HTTPS front end — only read by docker-compose.caddy.yml
# ---------------------------------------------------------------------------

# Domain to serve. Its DNS A/AAAA record must already point at this host, and
# ports 80 and 443 must be free and reachable, or the certificate order fails.
#FEEDFORGE_DOMAIN=feeds.example.com

# Contact address for the certificate authority (expiry warnings).
#ACME_EMAIL=you@example.com

# Ports the Caddy front end publishes. Leave them alone unless you know why
# you are moving them: Let's Encrypt validates over the real 80/443, and
# Caddy's own http->https redirect always points at 443. If you do change
# CADDY_HTTPS_PORT, set FEEDFORGE_BASE_URL above to include the new port, or
# every generated feed URL will advertise an origin that isn't listening.
#CADDY_HTTP_PORT=80
#CADDY_HTTPS_PORT=443
