# Keep LF in the working tree on every platform. A CRLF checkout of
# docker-entrypoint.sh makes the container fail to start with
# "bad interpreter: /bin/sh^M", and Go tooling expects LF too.
* text=auto eol=lf

*.sh      text eol=lf
Dockerfile text eol=lf
*.go      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.yml     text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.md      text eol=lf

# web/app.js is compiled from web/src/app.ts (npm run build); keep diffs
# collapsed on GitHub and reviews focused on the TypeScript source.
web/app.js linguist-generated=true
