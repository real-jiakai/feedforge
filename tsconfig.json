{
  "compilerOptions": {
    // The UI stays a single plain <script>: no modules, no bundler. tsc
    // compiles web/src/app.ts to web/app.js, which is committed so that
    // `go build` and the Docker image need no Node toolchain.
    "rootDir": "web/src",
    "outDir": "web",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "removeComments": false,
    "newLine": "lf"
  },
  "include": ["web/src/**/*.ts"],
  // Explicit so the default outDir exclusion does not swallow web/src,
  // which lives inside the outDir.
  "exclude": ["node_modules"]
}
